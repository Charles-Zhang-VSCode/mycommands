{
  "name": "mycommands",
  "displayName": "MyCommands",
  "description": "Some handy commands for everyday use.",
  "repository": "github:Charles-Zhang-VSCode/mycommands",
  "version": "0.0.4",
  "publisher": "methodox",
  "license": "MIT",
  "author": "Charles Zhang",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mycommands.sortline_csv",
        "title": "Sort Line Items (CSV) - MyCommands"
      },
      {
        "command": "mycommands.dot_lines",
        "title": "Dots (Enumerate Lines as MD Format) - MyCommands"
      },
      {
        "command": "mycommands.sort_markdown_sections",
        "title": "Sort Markdown Sections - MyCommands"
      },
      {
        "command": "mycommands.indent_markdown_sections",
        "title": "Indent Markdown Sections - MyCommands"
      },
      {
        "command": "mycommands.unindent_markdown_sections",
        "title": "Unindent Markdown Sections - MyCommands"
      },
      {
        "command": "mycommands.count_lines",
        "title": "Count Lines - MyCommands"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.78.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}
